# App Environment (local | staging | production)
APP_ENV=local

# Backend API Base URL (Android emulator: http://10.0.2.2:3000, iOS simulator: http://localhost:3000)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# WebSocket Base URL
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000/ws/subway

# Clerk Authentication Publishable Key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key

# Mobile Client Verification Key
EXPO_PUBLIC_CLIENT_KEY=dev-mobile-client-key
