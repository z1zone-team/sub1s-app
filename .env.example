# ==============================================================================
# Sub1S 모바일 애플리케이션 (.env) 설정 템플릿
# 이 파일을 복사하여 `.env` 파일을 생성한 후 실제 키 값을 입력하세요.
# (명령어: cp .env.example .env)
# ==============================================================================

# 앱 실행 환경 (local | staging | production)
APP_ENV=local

# 백엔드 NestJS 서버 API 주소
# - Android 에뮬레이터: http://10.0.2.2:3000
# - iOS 시뮬레이터 / 웹: http://localhost:3000
# - 모바일 실기기(Expo Go / Dev Client): http://<PC_로컬_IP>:3000 (예: http://192.168.0.15:3000)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# 실시간 웹소켓(Socket.io) 엔드포인트
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000/ws/subway

# Clerk 인증 Publishable Key
# - Clerk 대시보드 (https://dashboard.clerk.com) -> API Keys -> Publishable key
# - pk_test_... 형식의 키를 아래에 입력하세요.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key

# 모바일 클라이언트 검증 키 (백엔드 X-Sub1S-Client-Key 헤더 검증용)
EXPO_PUBLIC_CLIENT_KEY=dev-mobile-client-key
